OTP_URL_PREFIX=http://localhost/verify?code={code}
OTP_CODE_LEN=6
OTP_MAX_RETRIES=7
OTP_EXPIRES_SECONDS=300

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/auth_db

RATE_LIMIT_OTP=3/hour
RATE_LIMIT_DEFAULT=10/minute
SECURE_HEADERS=True
